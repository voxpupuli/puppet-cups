<% COMMENT_OUT ||= '# '.freeze -%>
<%# Iterate over active_directives hash -%>
<% @active_directives.each do | key, value | -%>
<%#  PageLogFormat,PreserveJobFiles, PreserveJobHistory, ServerAlias and web_interface settings need special handling -%>
<%#  all other key, values can be taken as is -%>
<%   case key -%>
<%     when 'PageLogFormat' -%>
<%=      COMMENT_OUT if value.nil? -%>PageLogFormat "<%= value %>"
<%     when 'PreserveJobFiles' -%>
<%=      COMMENT_OUT if value.nil? -%>PreserveJobFiles <%= value.is_a?(Integer) ? value : ((value == true || %w[true yes].include?(value.to_s.downcase)) ? 'Yes' : 'No') %>
<%     when 'PreserveJobHistory' -%>
<%=      COMMENT_OUT if value.nil? -%>PreserveJobHistory <%= value.is_a?(Integer) ? value : ((value == true || %w[true yes].include?(value.to_s.downcase)) ? 'Yes' : 'No') %>
<%     when 'ServerAlias' -%>
<%=      COMMENT_OUT if value.nil? -%>ServerAlias <%= value.is_a?(Array) ? value.join(' ') : value %>
<%     when 'WebInterface' -%>
<%=      COMMENT_OUT if value.nil? -%>WebInterface <%= (value ? 'Yes' : 'No') %>
<%     when 'BrowseDNSSDSubTypes_' -%>
<%=      COMMENT_OUT if value.nil? -%>BrowseDNSSDSubTypes_<%= value.is_a?(Array) ? value.join(',_') : value %>
<%     when 'BrowseLocalProtocols' -%>
<%=      COMMENT_OUT if value.nil? -%>BrowseLocalProtocols <%= value.is_a?(Array) ? value.join(' ') : value %>
<%     when 'BrowseWebIF' -%>
<%=      COMMENT_OUT if value.nil? -%>BrowseWebIF <%= (value ? 'Yes' : 'No') %>
<%     when 'Browsing' -%>
<%=      COMMENT_OUT if value.nil? -%>Browsing <%= (value ? 'Yes' : 'No') %>
<%     when 'Listen' -%>
<%=      COMMENT_OUT if value.nil? -%><% [value].flatten.each do |l| -%>Listen <%= l %><%= "\n"%><% end %>
<%     else -%>
<%=      COMMENT_OUT if value.nil? -%><%= key %> <%= value %>
<%#  case end -%>
<%   end -%>
<%# each end -%>
<% end -%>
DefaultAuthType Basic
